{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nova-forge:schemas:publication-receipt:v1",
  "title": "Nova Forge Immutable Publication Receipt",
  "description": "Immutable release identity binding creator, manifest digest, artifact digests, provenance/rights state, moderation state, version and timestamp. Presentation changes must not rewrite release identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "releaseIdentity", "creatorProfileRef", "manifestSha256", "artifacts", "provenanceState", "rightsState", "moderationState", "releaseState", "publishedAt", "distributable"],
  "properties": {
    "schemaVersion": {"const": 1},
    "receiptId": {"type": "string", "pattern": "^release:[a-z0-9][a-z0-9._:-]{7,191}$"},
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentId", "version", "identityDigest"],
      "properties": {
        "contentId": {"type": "string", "minLength": 3, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 120},
        "identityDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "creatorProfileRef": {"type": "string", "pattern": "^profile:[a-z0-9][a-z0-9._:-]{2,127}$"},
    "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "sha256", "sizeBytes"],
        "properties": {
          "artifactId": {"type": "string", "minLength": 3, "maxLength": 200},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sizeBytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "provenanceState": {"enum": ["verified", "declared-unattested", "unknown"]},
    "rightsState": {"enum": ["verified", "declared", "unknown", "restricted"]},
    "moderationState": {"enum": ["clear", "restricted", "removed", "under-review"]},
    "moderationReceiptId": {"type": ["string", "null"], "pattern": "^moderation:[a-z0-9][a-z0-9._:-]{7,191}$"},
    "releaseState": {"enum": ["published", "withdrawn", "revoked"]},
    "publishedAt": {"type": "string", "format": "date-time"},
    "stateChangedAt": {"type": ["string", "null"], "format": "date-time"},
    "distributable": {"type": "boolean"},
    "presentationRevision": {"type": "integer", "minimum": 0, "description": "Presentation metadata revision only; never part of historical release identity."},
    "previousPresentationRevision": {"type": ["integer", "null"], "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"releaseState": {"enum": ["withdrawn", "revoked"]}}},
      "then": {"properties": {"distributable": {"const": false}}}
    },
    {
      "if": {"properties": {"moderationState": {"enum": ["removed", "restricted"]}}},
      "then": {"properties": {"distributable": {"const": false}}}
    },
    {
      "if": {"properties": {"distributable": {"const": true}}},
      "then": {
        "properties": {
          "releaseState": {"const": "published"},
          "provenanceState": {"const": "verified"},
          "rightsState": {"const": "verified"},
          "moderationState": {"const": "clear"}
        }
      }
    }
  ]
}
