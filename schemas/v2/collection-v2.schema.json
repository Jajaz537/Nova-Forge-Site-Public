{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:modaryx:schemas:collection-v2:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "curatorId",
    "visibility",
    "gameIds",
    "tags",
    "items",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "curatorId": {
      "type": "string",
      "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
    },
    "visibility": {
      "enum": [
        "private",
        "unlisted",
        "public"
      ]
    },
    "gameIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contentId",
          "note",
          "order"
        ],
        "properties": {
          "contentId": {
            "type": "string",
            "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
          },
          "note": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "recommendedReleaseId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
