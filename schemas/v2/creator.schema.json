{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:modaryx:schemas:creator:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "handle",
    "displayName",
    "bio",
    "avatar",
    "links",
    "verificationState",
    "teamIds",
    "projectIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,39}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "bio": {
      "type": "string"
    },
    "avatar": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "verificationState": {
      "enum": [
        "unverified",
        "identity-verified",
        "program-verified"
      ]
    },
    "teamIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
      },
      "uniqueItems": true
    },
    "projectIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
      },
      "uniqueItems": true
    }
  }
}
