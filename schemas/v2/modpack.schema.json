{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:modaryx:schemas:modpack:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "gameId",
    "gameVersion",
    "loader",
    "version",
    "releaseConstraints",
    "configArtifacts",
    "dependencies",
    "conflicts",
    "rights",
    "provenance",
    "distribution",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "gameId": {
      "type": "string",
      "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1
    },
    "loader": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "releaseConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contentId",
          "range"
        ],
        "properties": {
          "contentId": {
            "type": "string",
            "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
          },
          "range": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "configArtifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
      },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
      },
      "uniqueItems": true
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "cleared",
            "restricted",
            "blocked"
          ]
        },
        "receiptId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "declared",
            "verified"
          ]
        },
        "receiptId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "downloadable"
      ],
      "properties": {
        "state": {
          "enum": [
            "draft",
            "available",
            "withdrawn",
            "revoked",
            "archived"
          ]
        },
        "downloadable": {
          "type": "boolean"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "distribution": {
            "properties": {
              "state": {
                "enum": [
                  "withdrawn",
                  "revoked",
                  "archived"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "distribution": {
            "properties": {
              "downloadable": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
