{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:modaryx:schemas:dependency:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceContentId",
    "sourceReleaseRange",
    "targetContentId",
    "targetReleaseRange",
    "relationType",
    "reason",
    "source",
    "verificationState"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
    },
    "sourceContentId": {
      "type": "string",
      "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
    },
    "sourceReleaseRange": {
      "type": "string",
      "minLength": 1
    },
    "targetContentId": {
      "type": "string",
      "pattern": "^mx_[a-z0-9][a-z0-9_-]{2,95}$"
    },
    "targetReleaseRange": {
      "type": "string",
      "minLength": 1
    },
    "relationType": {
      "enum": [
        "required",
        "optional",
        "recommended",
        "incompatible",
        "replaces"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "manifest",
        "creator",
        "curator",
        "measured",
        "moderator",
        "unknown"
      ]
    },
    "verificationState": {
      "enum": [
        "verified",
        "declared",
        "unverified",
        "unknown"
      ]
    }
  }
}
