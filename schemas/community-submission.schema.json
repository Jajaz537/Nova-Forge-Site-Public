{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-forge.invalid/schemas/community-submission.schema.json",
  "title": "Nova Forge Local Community Submission V1",
  "description": "Portable local-only draft for a future community submission. It is not a publication, moderation receipt, account assertion or network write.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "targetId", "body", "authorProfileId", "syncState", "publicationState", "moderationState"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "kind": {"enum": ["discussion", "review", "comment"]},
    "targetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "body": {"type": "string", "minLength": 1, "maxLength": 8000},
    "rating": {"type": "integer", "minimum": 1, "maximum": 5},
    "parentSubmissionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "authorProfileId": {"type": "null"},
    "syncState": {"const": "local-only"},
    "publicationState": {"const": "local-draft"},
    "moderationState": {"const": "not-submitted"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "review"}}, "required": ["kind"]},
      "then": {"required": ["title", "rating"]}
    },
    {
      "if": {"properties": {"kind": {"const": "discussion"}}, "required": ["kind"]},
      "then": {"required": ["title"], "not": {"anyOf": [{"required": ["rating"]}, {"required": ["parentSubmissionId"]}]}}
    },
    {
      "if": {"properties": {"kind": {"const": "comment"}}, "required": ["kind"]},
      "then": {"required": ["parentSubmissionId"], "not": {"anyOf": [{"required": ["title"]}, {"required": ["rating"]}]}}
    }
  ]
}
