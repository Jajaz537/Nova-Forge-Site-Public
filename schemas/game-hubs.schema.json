{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nova-forge:schemas:game-hubs:v1",
  "title": "Nova Forge Game Hubs Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stage", "policy", "games"],
  "properties": {
    "schemaVersion": {"const": 1},
    "stage": {"const": "pre-vf"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noFakeCatalogVolume", "unknownCompatibilityStaysUnknown", "emptySeoCategoryPagesForbidden", "verifiedArtifactRequiredForDownload"],
      "properties": {
        "noFakeCatalogVolume": {"const": true},
        "unknownCompatibilityStaysUnknown": {"const": true},
        "emptySeoCategoryPagesForbidden": {"const": true},
        "verifiedArtifactRequiredForDownload": {"const": true}
      }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "hub", "modsHub", "supportState", "compatibilityEvidence", "publicModsPublished", "distributionAvailable", "note"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
          "name": {"type": "string", "minLength": 2, "maxLength": 160},
          "hub": {"type": ["string", "null"], "pattern": "^/[^?#]*$"},
          "modsHub": {"type": ["string", "null"], "pattern": "^/[^?#]*$"},
          "supportState": {"enum": ["adapter-not-validated", "hub-ready-no-verified-public-release", "metadata-preview-only"]},
          "compatibilityEvidence": {"enum": ["measured", "estimated", "unknown"]},
          "publicModsPublished": {"type": "integer", "minimum": 0},
          "distributionAvailable": {"const": false},
          "note": {"type": "string", "minLength": 12, "maxLength": 1000}
        }
      }
    }
  }
}
