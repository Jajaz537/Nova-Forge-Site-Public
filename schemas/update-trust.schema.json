{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nova-forge:schemas:update-trust:v1",
  "title": "Nova Forge TUF-inspired update trust metadata",
  "type": "object",
  "required": ["schema","roles"],
  "properties": {
    "schema": {"const": "nova-forge-update-trust/v1"},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp","snapshot","targets"],
      "properties": {
        "timestamp": {"type":"object","required":["threshold","keys"],"properties":{"threshold":{"type":"integer","minimum":1},"keys":{"type":"array","minItems":1,"items":{"type":"object","required":["keyId","algorithm","publicKeyJwk"],"properties":{"keyId":{"type":"string","minLength":2,"maxLength":128},"algorithm":{"const":"ECDSA-P256-SHA256"},"publicKeyJwk":{"type":"object"}}}}}},
        "snapshot": {"type":"object","required":["threshold","keys"],"properties":{"threshold":{"type":"integer","minimum":1},"keys":{"type":"array","minItems":1,"items":{"type":"object","required":["keyId","algorithm","publicKeyJwk"],"properties":{"keyId":{"type":"string","minLength":2,"maxLength":128},"algorithm":{"const":"ECDSA-P256-SHA256"},"publicKeyJwk":{"type":"object"}}}}}},
        "targets": {"type":"object","required":["threshold","keys"],"properties":{"threshold":{"type":"integer","minimum":1},"keys":{"type":"array","minItems":1,"items":{"type":"object","required":["keyId","algorithm","publicKeyJwk"],"properties":{"keyId":{"type":"string","minLength":2,"maxLength":128},"algorithm":{"const":"ECDSA-P256-SHA256"},"publicKeyJwk":{"type":"object"}}}}}}
      }
    }
  }
}
